# Copy to .env (development), .env.production, etc. Gitignored — never commit real values.
# Anything here ships inside the JS bundle, so it is NOT secret storage.
# Select a file at build time with: ENV_FILE=.env.production npm run android
# (then reset Metro cache once: npx react-native start --reset-cache)

# development | staging | production
APP_ENV=development

# Backend origin, no trailing slash. Endpoint paths already include /api.
# Dev: your Mac's LAN IP + backend PORT (default 5001). Android emulator can use 10.0.2.2 instead.
API_BASE_URL=http://192.168.1.15:5001
