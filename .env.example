# Copy to .env (gitignored — never commit real values).
# EXPO_PUBLIC_* values ship inside the JS bundle, so they are NOT secret storage.
# Restart Metro after editing: npx expo start -c

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Backend origin, no trailing slash. Endpoint paths already include /api.
# Local NON-PRODUCTION backend: your Mac's LAN IP + the backend PORT (default
# 5001), e.g. http://<LAN-IP>:5001 (a phone cannot reach localhost). Plain HTTP
# works in Expo Go on Android dev; iOS Expo Go also allows local-network HTTP.
# The backend must run against a local/test database, never production data.
EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:5001

# true = in-app mock services (default, used by tests). false = call the real backend.
# Online payments (Razorpay in a WebView) only start with rzp_test_ keys; a
# live or unknown key falls back to "not available" and never charges.
EXPO_PUBLIC_USE_MOCKS=true
